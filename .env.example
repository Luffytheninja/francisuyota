# ──────────────────────────────────────
# Francis Uyota Portfolio – Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to Git.
# ──────────────────────────────────────

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=g3jd0ba2
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Required for write operations (mutations) from API routes
SANITY_API_TOKEN=

# Google Analytics 4
# Get this from https://analytics.google.com  → Admin → Data Streams → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Plausible Analytics
# Set to your domain e.g. uyota.film
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=uyota.film

# Contact Form
# Email to receive contact form submissions (server-side only)
CONTACT_EMAIL=hello@uyota.film
# Optional: SMTP credentials for future email integration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Site URL (used for OG tags & sitemap)
NEXT_PUBLIC_SITE_URL=https://uyota.film
